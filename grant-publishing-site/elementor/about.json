            {
              "id": "99d74323",
              "elType": "widget",
              "widgetType": "text-editor",
              "isInner": false,
              "settings": {
                "_title": "Copy",
                "_css_classes": "gp-copy",
                "editor": "<p>I’m AbdulQudus Tella, a Book Marketing Strategist. My work brings together Amazon visibility, book presentation and practical marketing planning, with publishing support where the project needs it.</p>"
              },
              "elements": []
            },
            {
              "id": "d836f2f9",
              "elType": "widget",
              "widgetType": "text-editor",
              "isInner": false,
              "settings": {
                "_title": "Copy",
                "_css_classes": "gp-copy",
                "editor": "<p>I begin by looking at the book and the problem you want to solve. The aim is to identify what needs attention, explain why it matters and agree a useful next step.</p>"
              },
              "elements": []
            }
          ]
        }
      ]
