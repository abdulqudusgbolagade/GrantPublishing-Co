                    },
                    {
                      "id": "fdbed232",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "isInner": false,
                      "settings": {
                        "_title": "Copy",
                        "_css_classes": "gp-copy",
                        "editor": "<p>Prepare Amazon Ads campaigns around your book, audience and advertising budget. Setup gives you a defined starting point. Optional ongoing management provides campaign review and adjustments on a recurring basis.</p>"
                      },
                      "elements": []
                    },
                    {
                      "id": "13fabe29",
                      "elType": "widget",
                      "widgetType": "heading",
                      "isInner": false,
                      "settings": {
                        "_title": "Subheading",
                        "_css_classes": "gp-subheading",
                        "title": "What we can work on",
                        "header_size": "h2"
                      },
                      "elements": []
                    },
                    {
                      "id": "baa982bf",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "isInner": false,
                      "settings": {
                        "_title": "Deliverables",
                        "_element_id": "service-scope",
                        "_css_classes": "gp-deliverables",
                        "editor": "<ul>\n<li>Campaign structure and relevant keyword or product targeting research</li>\n<li>Initial bid and budget settings agreed with you</li>\n<li>Campaign setup and a clear handover of the structure and settings</li>\n<li>Optional ongoing management, reporting and adjustments within the agreed scope</li>\n</ul>"
                      },
                      "elements": []
                    },
                    {
                      "id": "7de894ab",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "isInner": false,
                      "settings": {
                        "_title": "Copy",
                        "_css_classes": "gp-copy",
                        "editor": "<p>Advertising works alongside your listing and wider promotion. Explore <a href=\"{{url:amazon-visibility}}\">Amazon Book Visibility</a>, <a href=\"{{url:book-strategy}}\">Book Marketing Strategy</a> and <a href=\"{{url:launch-promotion}}\">Book Launch &amp; Promotion</a>.</p>"
                      },
                      "elements": []
                    },
                    {
                      "id": "0aac4291",
                      "elType": "widget",
                      "widgetType": "heading",
                      "isInner": false,
                      "settings": {
                        "_title": "Subheading",
                        "_css_classes": "gp-subheading",
                        "title": "What to share",
                        "header_size": "h2"
                      },
                      "elements": []
                    },
                    {
                      "id": "1363c44f",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "isInner": false,
                      "settings": {
                        "_title": "Copy",
                        "_css_classes": "gp-copy",
                        "editor": "<p>Share your Amazon book link, target marketplace, publication formats, budget and advertising goals. We confirm account access and campaign eligibility before setup. Setup fees and recurring management fees are agreed in the proposal. Amazon ad spend is separate and paid through your advertising account.</p>"
                      },
                      "elements": []
                    }
