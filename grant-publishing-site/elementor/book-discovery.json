              },
              "elements": []
            },
            {
              "id": "5816488a",
              "elType": "widget",
              "widgetType": "text-editor",
              "isInner": false,
              "settings": {
                "_css_classes": "gp-lead",
                "_title": "Text Editor",
                "editor": "<p>Publication makes a book available. The next question is whether the right reader can recognise it.</p>"
              },
              "elements": []
            }
          ]
        }
