            {
              "id": "2d5734b9",
              "elType": "container",
              "isInner": false,
              "settings": {
                "css_classes": "gp-article-body",
                "content_width": "full",
                "flex_direction": "column",
                "_title": "Article Body",
                "padding": {
                  "unit": "px",
