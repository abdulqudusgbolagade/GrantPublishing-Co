            {
              "id": "5bb0aa41",
              "elType": "container",
              "isInner": false,
              "settings": {
                "_title": "Article Body",
                "css_classes": "gp-article-body",
                "content_width": "full",
                "flex_direction": "column",
                "padding": {
                  "unit": "px",
