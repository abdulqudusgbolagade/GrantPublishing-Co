                {
                  "id": "ec9c4ecf",
                  "elType": "widget",
                  "widgetType": "heading",
                  "isInner": false,
                  "settings": {
                    "_title": "Subheading",
                    "_css_classes": "gp-subheading",
                    "title": "The challenge and starting materials",
